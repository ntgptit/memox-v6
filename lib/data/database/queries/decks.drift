import '../tables/content.drift';

-- Deck aggregate queries (WBS 4.4A). Rename/move/delete are explicit
-- UPDATE/DELETE statements so the 4.3 exclusivity and cycle triggers
-- guard every path.

insertDeck:
INSERT INTO decks (
  id, language_pair_id, parent_id, name, normalized_name, created_at,
  updated_at
) VALUES (
  :id, :languagePairId, :parentId, :name, :normalizedName, :createdAt,
  :updatedAt
);

findDeckById:
SELECT * FROM decks WHERE id = :id;

watchRootDecks:
SELECT * FROM decks
WHERE language_pair_id = :languagePairId AND parent_id IS NULL
ORDER BY normalized_name, id;

-- Root decks with their direct card count and study-status counters (kit
-- deck-card meta line). Counts exclude soft-deleted cards; due/new also
-- exclude hidden cards to match the study-scope semantics (pageDueProgress).
--
-- Classification follows surface-due-cards.md §4 and matches
-- countDeckQueues: `new` = box 0, `due` = box 1..7 scheduled at or before
-- :nowUtc, box 8 is mastered and in neither.
--
-- This used to read `new` as "no progress row at all", which no card can
-- ever satisfy: creating a card writes its box-0 row in the same
-- transaction (initialise-card-progress.md §1), so new_count was
-- structurally 0 and every deck rendered "up to date". Recorded as
-- `int-2`; WBS 5.4.1 made New a box value by construction and this is
-- the read side of that fix.
--
-- Still direct cards only. A Parent's subtree totals are the deck-detail
-- scope (countSubtreeCards / countDeckQueues) — switching this row to a
-- subtree aggregate changes what the Library renders, so it belongs to
-- the Library display contract, not to this query.
watchRootDeckSummaries:
SELECT d.*,
  COUNT(DISTINCT CASE WHEN f.deleted_at IS NULL THEN f.id END) AS card_count,
  COUNT(DISTINCT CASE
    WHEN f.deleted_at IS NULL AND f.is_hidden = 0
      AND learning_progress.box BETWEEN 1 AND 7
      AND learning_progress.due_at IS NOT NULL
      AND learning_progress.due_at <= CAST(:nowUtc AS INTEGER)
      THEN f.id END) AS due_count,
  COUNT(DISTINCT CASE
    WHEN f.deleted_at IS NULL AND f.is_hidden = 0
      AND learning_progress.box = 0 THEN f.id END) AS new_count,
  COUNT(DISTINCT CASE
    WHEN f.deleted_at IS NULL AND f.is_hidden = 0
      AND learning_progress.box = 8 THEN f.id END) AS mastered_count,
  COUNT(DISTINCT CASE
    WHEN f.deleted_at IS NULL AND f.is_hidden = 0
      THEN f.id END) AS studiable_count
FROM decks d
LEFT JOIN flashcards f ON f.deck_id = d.id
LEFT JOIN learning_progress ON learning_progress.card_id = f.id
WHERE d.language_pair_id = :languagePairId AND d.parent_id IS NULL
GROUP BY d.id
ORDER BY d.normalized_name, d.id;

-- The same row as watchRootDeckSummaries, scoped to one parent's direct
-- children — the deck-detail Parent branch renders the identical deck card
-- the Library root does, so it needs the identical counters.
--
-- Direct cards only, matching the root query. A child that is itself a
-- Parent therefore reports its own direct cards rather than its subtree;
-- that is the same open Library display-contract question the root query
-- records, and answering it differently here would make the two lists
-- disagree about what a number on a deck card means.
watchChildDeckSummaries:
SELECT d.*,
  COUNT(DISTINCT CASE WHEN f.deleted_at IS NULL THEN f.id END) AS card_count,
  COUNT(DISTINCT CASE
    WHEN f.deleted_at IS NULL AND f.is_hidden = 0
      AND learning_progress.box BETWEEN 1 AND 7
      AND learning_progress.due_at IS NOT NULL
      AND learning_progress.due_at <= CAST(:nowUtc AS INTEGER)
      THEN f.id END) AS due_count,
  COUNT(DISTINCT CASE
    WHEN f.deleted_at IS NULL AND f.is_hidden = 0
      AND learning_progress.box = 0 THEN f.id END) AS new_count,
  COUNT(DISTINCT CASE
    WHEN f.deleted_at IS NULL AND f.is_hidden = 0
      AND learning_progress.box = 8 THEN f.id END) AS mastered_count,
  COUNT(DISTINCT CASE
    WHEN f.deleted_at IS NULL AND f.is_hidden = 0
      THEN f.id END) AS studiable_count
FROM decks d
LEFT JOIN flashcards f ON f.deck_id = d.id
LEFT JOIN learning_progress ON learning_progress.card_id = f.id
WHERE d.parent_id = :parentId
GROUP BY d.id
ORDER BY d.normalized_name, d.id;

-- The Dashboard's "Recent decks" rows (`load-today-dashboard.md` §3: Deck
-- summaries are a supporting section of Today).
--
-- Same counters as the Library rows, ordered by when the deck was last
-- studied rather than by name — `learning_progress.last_reviewed_at` is the
-- instant the most recent terminal grade was applied (SRS policy §8), so the
-- newest of a deck's cards is the deck's own last-studied time.
--
-- A deck nobody has graded yet has no such instant. Those sort last, by name,
-- rather than being dropped: a learner who has created decks but not started
-- has a Library, and a "Recent decks" section that hid it would say the
-- opposite. `IS NULL` sorts first ascending in SQLite, hence the explicit
-- leading key.
recentRootDeckSummaries:
SELECT d.*,
  COUNT(DISTINCT CASE WHEN f.deleted_at IS NULL THEN f.id END) AS card_count,
  COUNT(DISTINCT CASE
    WHEN f.deleted_at IS NULL AND f.is_hidden = 0
      AND learning_progress.box BETWEEN 1 AND 7
      AND learning_progress.due_at IS NOT NULL
      AND learning_progress.due_at <= CAST(:nowUtc AS INTEGER)
      THEN f.id END) AS due_count,
  COUNT(DISTINCT CASE
    WHEN f.deleted_at IS NULL AND f.is_hidden = 0
      AND learning_progress.box = 0 THEN f.id END) AS new_count,
  COUNT(DISTINCT CASE
    WHEN f.deleted_at IS NULL AND f.is_hidden = 0
      AND learning_progress.box = 8 THEN f.id END) AS mastered_count,
  COUNT(DISTINCT CASE
    WHEN f.deleted_at IS NULL AND f.is_hidden = 0
      THEN f.id END) AS studiable_count,
  MAX(CASE WHEN f.deleted_at IS NULL AND f.is_hidden = 0
      THEN learning_progress.last_reviewed_at END) AS last_studied_at
FROM decks d
LEFT JOIN flashcards f ON f.deck_id = d.id
LEFT JOIN learning_progress ON learning_progress.card_id = f.id
WHERE d.language_pair_id = :languagePairId AND d.parent_id IS NULL
GROUP BY d.id
ORDER BY last_studied_at IS NULL, last_studied_at DESC,
  d.normalized_name, d.id
LIMIT :limit;

watchChildDecks:
SELECT * FROM decks WHERE parent_id = :parentId
ORDER BY normalized_name, id;

-- The editable metadata of a deck, written together.
-- `edit-deck.md` §1 makes the name and the description one save, so a
-- failure cannot persist half of the form.
editDeckMetadata:
UPDATE decks SET name = :name, normalized_name = :normalizedName,
  description = :description, normalized_description = :normalizedDescription,
  updated_at = :updatedAt
WHERE id = :deckId;

renameDeck:
UPDATE decks SET name = :name, normalized_name = :normalizedName,
  updated_at = :updatedAt
WHERE id = :id;

moveDeck:
UPDATE decks SET parent_id = :parentId, updated_at = :updatedAt
WHERE id = :id;

deleteDeck:
DELETE FROM decks WHERE id = :id;

-- The subtree a delete removes: the deck and every descendant
-- (`delete-deck.md` §1, "Parent delete áp dụng toàn descendants").
deckSubtreeIds:
WITH RECURSIVE subtree (id) AS (
  SELECT id FROM decks WHERE id = :deckId
  UNION ALL
  SELECT d.id FROM decks d INNER JOIN subtree s ON d.parent_id = s.id
)
SELECT id FROM subtree;

-- Cards of a whole subtree, deleted before the decks themselves.
-- `flashcards.deck_id` has no ON DELETE CASCADE, so removing a deck that
-- still holds cards is a foreign-key violation — which is what deleting any
-- non-empty deck used to be. Translations, tags, audio refs and learning
-- progress all cascade from the card, so this one statement takes them.
deleteFlashcardsInDecks:
DELETE FROM flashcards WHERE deck_id IN (
  WITH RECURSIVE subtree (id) AS (
    SELECT id FROM decks WHERE id = :deckId
    UNION ALL
    SELECT d.id FROM decks d INNER JOIN subtree s ON d.parent_id = s.id
  )
  SELECT id FROM subtree
);

-- The decks themselves, deepest first so no parent is removed before its
-- children (`parent_id` references the same table).
deleteDeckSubtree:
DELETE FROM decks WHERE id IN (
  WITH RECURSIVE subtree (id) AS (
    SELECT id FROM decks WHERE id = :deckId
    UNION ALL
    SELECT d.id FROM decks d INNER JOIN subtree s ON d.parent_id = s.id
  )
  SELECT id FROM subtree
);

-- Studying a deck leaves rows that reference it and its cards, and none of
-- those references cascade. A deck that had ever been studied was therefore
-- undeletable — the common case, since decks are usually deleted *because*
-- they have been used.
--
-- `learning_progress.last_terminal_attempt_id` points at an attempt, so it is
-- cleared before the attempts go; the progress rows themselves cascade from
-- the card later.
clearTerminalAttemptRefsInDecks:
UPDATE learning_progress SET last_terminal_attempt_id = NULL
WHERE card_id IN (
  SELECT id FROM flashcards WHERE deck_id IN (
  WITH RECURSIVE subtree (id) AS (
    SELECT id FROM decks WHERE id = :deckId
    UNION ALL
    SELECT d.id FROM decks d INNER JOIN subtree s ON d.parent_id = s.id
  )
  SELECT id FROM subtree
  )
);

-- Attempts reference the card, which has no cascade of its own.
deleteAttemptsInDecks:
DELETE FROM study_attempts WHERE card_id IN (
  SELECT id FROM flashcards WHERE deck_id IN (
  WITH RECURSIVE subtree (id) AS (
    SELECT id FROM decks WHERE id = :deckId
    UNION ALL
    SELECT d.id FROM decks d INNER JOIN subtree s ON d.parent_id = s.id
  )
  SELECT id FROM subtree
  )
);

-- Sessions reference the deck. Their card snapshots, checkpoints, round
-- orders and relearn items all cascade from the session id, which is why this
-- runs before the cards are removed.
deleteSessionsInDecks:
DELETE FROM study_sessions WHERE deck_id IN (
  WITH RECURSIVE subtree (id) AS (
    SELECT id FROM decks WHERE id = :deckId
    UNION ALL
    SELECT d.id FROM decks d INNER JOIN subtree s ON d.parent_id = s.id
  )
  SELECT id FROM subtree
);

countChildDecks:
SELECT COUNT(*) AS child_count FROM decks WHERE parent_id = :parentId;

updateDeckDescription:
UPDATE decks SET description = :description, updated_at = :updatedAt
WHERE id = :id;

countDecksForLanguagePair:
SELECT COUNT(*) AS deck_count FROM decks
WHERE language_pair_id = :languagePairId;

-- Cards of a subtree that carry study history, for the delete confirm.
-- `delete-deck.md` §1 requires the copy to name "số child Deck, card và
-- learning progress bị xóa"; the impact reported the first two.
--
-- Counting progress *rows* would just restate the card count — every card has
-- one from creation (`initialise-card-progress.md` §1). What a learner loses
-- is the history: Box 0 is "never introduced" (`srs-8-box-policy.md`), so
-- progress begins at Box 1.
countSubtreeStudiedCards:
WITH RECURSIVE subtree (id) AS (
  SELECT :deckId
  UNION ALL
  SELECT d.id FROM decks d INNER JOIN subtree s ON d.parent_id = s.id
)
SELECT COUNT(*) AS studied_count FROM flashcards f
INNER JOIN learning_progress lp ON lp.card_id = f.id
WHERE f.deck_id IN (SELECT id FROM subtree)
  AND f.deleted_at IS NULL
  AND lp.box > 0;

countSubtreeCards:
WITH RECURSIVE subtree (id) AS (
  SELECT :deckId
  UNION ALL
  SELECT d.id FROM decks d INNER JOIN subtree s ON d.parent_id = s.id
)
SELECT COUNT(*) AS card_count FROM flashcards
WHERE deck_id IN (SELECT id FROM subtree) AND deleted_at IS NULL;

-- Nested decks below a deck (all descendants, excluding the deck itself) — the
-- delete/reset impact summary (delete-deck.md §4). A descendant is any deck
-- whose parent is somewhere in the subtree.
countSubtreeDecks:
WITH RECURSIVE subtree (id) AS (
  SELECT :deckId
  UNION ALL
  SELECT d.id FROM decks d INNER JOIN subtree s ON d.parent_id = s.id
)
SELECT COUNT(*) AS deck_count FROM decks
WHERE parent_id IN (SELECT id FROM subtree);

-- The ancestor chain of a deck (root → … → the deck itself) — the breadcrumb
-- path (WBS 6.2). `depth` counts up from the deck to the root, so ORDER BY
-- depth DESC yields the root first and the deck itself last.
deckAncestors:
WITH RECURSIVE chain (id, language_pair_id, parent_id, name, normalized_name,
  description, normalized_description, created_at, updated_at, depth) AS (
  SELECT id, language_pair_id, parent_id, name, normalized_name, description,
    normalized_description, created_at, updated_at, 0 FROM decks
  WHERE id = :deckId
  UNION ALL
  SELECT d.id, d.language_pair_id, d.parent_id, d.name, d.normalized_name,
    d.description, d.normalized_description, d.created_at, d.updated_at,
    chain.depth + 1
  FROM decks d INNER JOIN chain ON d.id = chain.parent_id
)
SELECT id, language_pair_id, parent_id, name, normalized_name, description,
  normalized_description, created_at, updated_at FROM chain
ORDER BY depth DESC;

-- Valid move destinations for :movingDeckId (WBS 6.2 reparent). Every deck in
-- the pair that is NOT inside the moving deck's own subtree (moving into a
-- descendant would cycle), holds no direct active cards (deck exclusivity 4.3
-- forbids a deck owning both cards and child decks), and is not the deck's
-- current parent (a no-op move). Ordered by name for the picker.
-- Every deck in the pair as a move destination, with the reason an
-- ineligible one cannot be chosen (`move-deck.md` §3 node E, §4, §11).
--
-- The picker used to show only the eligible rows, which left a learner unable
-- to tell a deck that holds cards from one that is simply missing. §5's rules
-- become a reason string here so the list can disable a row and say why; the
-- store still has final say on the write.
moveDestinationCandidates:
WITH RECURSIVE subtree (id) AS (
  SELECT :movingDeckId
  UNION ALL
  SELECT d.id FROM decks d INNER JOIN subtree s ON d.parent_id = s.id
)
SELECT d.*,
  CASE
    WHEN d.id = :movingDeckId THEN 'self'
    WHEN d.id IN (SELECT id FROM subtree) THEN 'descendant'
    WHEN EXISTS (
      SELECT 1 FROM flashcards f
      WHERE f.deck_id = d.id AND f.deleted_at IS NULL
    ) THEN 'holdsCards'
    WHEN d.id IS (SELECT parent_id FROM decks WHERE id = :movingDeckId)
      THEN 'alreadyThere'
    ELSE 'eligible'
  END AS ineligibility
FROM decks d
WHERE d.language_pair_id = :languagePairId
ORDER BY d.normalized_name, d.id;

moveDestinationDecks:
WITH RECURSIVE subtree (id) AS (
  SELECT :movingDeckId
  UNION ALL
  SELECT d.id FROM decks d INNER JOIN subtree s ON d.parent_id = s.id
)
SELECT d.* FROM decks d
WHERE d.language_pair_id = :languagePairId
  AND d.id NOT IN (SELECT id FROM subtree)
  AND d.id IS NOT (SELECT parent_id FROM decks WHERE id = :movingDeckId)
  AND NOT EXISTS (
    SELECT 1 FROM flashcards f
    WHERE f.deck_id = d.id AND f.deleted_at IS NULL
  )
ORDER BY d.normalized_name, d.id;

-- Library search read-model (WBS 10.1; search-library-content.md,
-- search-rank-v1). Ranks card-term and deck-name matches across the pair by
-- the absolute tier order exact(0) → prefix(1) → contained(2), then the field
-- priority Card.term(0) → Deck.name(1), then a stable normalized/id tie-break.
-- Deleted cards are excluded before ranking; hidden ones are not. `hide-
-- flashcard.md` §1 keeps a hidden Card findable and manageable and excludes it
-- only from fresh study queues, so search returns it with `is_hidden` set and
-- the row says so. Card term and deck name are normalized differently, so the
-- caller passes each its own normalized query.
--
-- `context_name` is what tells two same-named results apart: the owning deck
-- for a card, the parent deck for a nested deck, and null for a root deck —
-- which the row renders as the Library. `search-decks.md` §1 requires results
-- to carry "path/language pair đủ để phân biệt tên giống nhau ở context khác"
-- and `search-library-content.md` §3 says a result shows "matched field, type
-- và path; không chỉ tên".
--
-- `subtitle` is the matched object's own second line — a card's primary
-- meaning, a deck's description — which the kit's `StatusCardRow` draws under
-- the term. It is content the index already holds; §3 of
-- `update-search-index.md` forbids reaching past that into Progress.
-- Meaning/translation matching needs normalized storage those columns lack —
-- a recorded follow-up.
searchLibraryContent:
SELECT f.id AS id, 'card' AS result_type, f.term AS display_text,
  f.deck_id AS deck_id,
  CASE
    WHEN f.normalized_term = :cardQuery THEN 0
    WHEN f.normalized_term LIKE :cardQuery || '%' THEN 1
    ELSE 2
  END AS tier,
  0 AS field_priority, f.normalized_term AS sort_key, f.is_hidden AS is_hidden,
  fd.name AS context_name, f.primary_meaning AS subtitle
FROM flashcards f
INNER JOIN decks fd ON fd.id = f.deck_id
WHERE fd.language_pair_id = :languagePairId
  AND f.deleted_at IS NULL
  AND f.normalized_term LIKE '%' || :cardQuery || '%'
UNION ALL
SELECT d.id AS id, 'deck' AS result_type, d.name AS display_text,
  d.id AS deck_id,
  CASE
    WHEN d.normalized_name = :deckQuery THEN 0
    WHEN d.normalized_name LIKE :deckQuery || '%' THEN 1
    ELSE 2
  END AS tier,
  1 AS field_priority, d.normalized_name AS sort_key, 0 AS is_hidden,
  parent.name AS context_name, d.description AS subtitle
FROM decks d
LEFT JOIN decks parent ON parent.id = d.parent_id
WHERE d.language_pair_id = :languagePairId
  AND d.normalized_name LIKE '%' || :deckQuery || '%'
UNION ALL
-- §5: "Match trên Deck name; description là supporting match" and
-- "Exact/prefix name đứng trước partial description match". Tier 3 puts every
-- description hit behind every name hit, and a deck matching on both is
-- carried by its name row rather than listed twice.
SELECT d.id AS id, 'deck' AS result_type, d.name AS display_text,
  d.id AS deck_id,
  3 AS tier,
  2 AS field_priority, d.normalized_name AS sort_key, 0 AS is_hidden,
  parent.name AS context_name, d.description AS subtitle
FROM decks d
LEFT JOIN decks parent ON parent.id = d.parent_id
WHERE d.language_pair_id = :languagePairId
  AND d.normalized_description IS NOT NULL
  AND d.normalized_description LIKE '%' || :deckQuery || '%'
  AND d.normalized_name NOT LIKE '%' || :deckQuery || '%'
ORDER BY tier, field_priority, sort_key, id;

-- Every deck in the pair as a card target, with the reason an ineligible one
-- cannot receive the card (`add-content-to-deck.md` §3 node F, §4).
--
-- §4 draws a Parent row disabled and labelled rather than absent, and §3's
-- ineligible branch is "Disabled · choose child". The picker showed only the
-- eligible rows, so a Parent a learner was looking for simply was not there.
cardTargetCandidates:
SELECT d.*,
  CASE
    WHEN d.id = :sourceDeckId THEN 'sourceDeck'
    WHEN EXISTS (SELECT 1 FROM decks child WHERE child.parent_id = d.id)
      THEN 'isParent'
    ELSE 'eligible'
  END AS ineligibility
FROM decks d
WHERE d.language_pair_id = :languagePairId
ORDER BY d.normalized_name, d.id;

-- Valid move targets for a card (WBS 6.5 move-flashcard). Every deck in the
-- pair that can hold cards — Empty or Leaf, i.e. it has no child decks (a deck
-- with children is a Parent and 4.3 exclusivity forbids it owning cards) —
-- excluding the card's current deck. Ordered by name for the picker.
cardMoveDestinationDecks:
SELECT d.* FROM decks d
WHERE d.language_pair_id = :languagePairId
  AND d.id != :sourceDeckId
  AND NOT EXISTS (SELECT 1 FROM decks child WHERE child.parent_id = d.id)
ORDER BY d.normalized_name, d.id;

-- The active card ids in a deck's whole subtree — the reset-progress scope
-- (reset-deck-progress.md); Leaf = direct cards, Parent = descendant cards.
subtreeCardIds:
WITH RECURSIVE subtree (id) AS (
  SELECT :deckId
  UNION ALL
  SELECT d.id FROM decks d INNER JOIN subtree s ON d.parent_id = s.id
)
SELECT id FROM flashcards
WHERE deck_id IN (SELECT id FROM subtree) AND deleted_at IS NULL;
