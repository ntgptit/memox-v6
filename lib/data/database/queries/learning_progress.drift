import '../tables/progress.drift';
import '../tables/content.drift';

-- Learning Progress aggregate queries (WBS 4.4B). The DAO stays
-- mechanical: box/interval decisions come from
-- lib/domain/learning_progress policies via the repository layer; the
-- revision guard here only enforces optimistic concurrency.

insertProgress:
INSERT INTO learning_progress (
  id, card_id, box, due_at, created_at, updated_at
) VALUES (
  :id, :cardId, :box, :dueAt, :createdAt, :updatedAt
);

-- WBS 5.4.1 initialise/repair: the New state per
-- initialise-card-progress.md §4 — box 0, no due date, and the
-- policy_id/policy_version schema defaults. Box and due date are
-- pinned in SQL rather than passed in, so no call site can persist a
-- "New" row that has already activated SRS. OR IGNORE makes the
-- statement idempotent against the card_id UNIQUE index, which is what
-- resolves a concurrent initialise to a single row instead of a
-- unique-constraint failure. A foreign-key violation still aborts, so
-- an unknown card cannot leave an orphan row behind.
insertNewProgressIfAbsent:
INSERT OR IGNORE INTO learning_progress (
  id, card_id, box, due_at, created_at, updated_at
) VALUES (
  :id, :cardId, 0, NULL, :createdAt, :updatedAt
);

-- Due + New study candidates in a deck scope (5.4.2, surface-due-cards.md §4):
-- the recursive subtree of :scopeDeckId, each eligible card classified once.
-- New = Box 0 & no due date; Due = Box 1..7 & due_at <= now (equal is due).
-- Box 8 (mastered) and hidden/deleted cards are excluded. Read-only, no
-- double-count (one progress row per card, one subtree membership). :nowUtc
-- binds as text so it is CAST back to the integer epoch it is compared to.
studyCandidatesInScope:
WITH RECURSIVE subtree(id) AS (
  SELECT id FROM decks WHERE id = :scopeDeckId
  UNION ALL
  SELECT d.id FROM decks d INNER JOIN subtree ON d.parent_id = subtree.id
)
SELECT f.id AS card_id,
  (learning_progress.box = 0 AND learning_progress.due_at IS NULL) AS is_new
FROM flashcards f
INNER JOIN subtree ON subtree.id = f.deck_id
INNER JOIN learning_progress ON learning_progress.card_id = f.id
WHERE f.deleted_at IS NULL AND f.is_hidden = 0
  AND (
    (learning_progress.box = 0 AND learning_progress.due_at IS NULL)
    OR (learning_progress.box >= 1 AND learning_progress.box <= 7
        AND learning_progress.due_at IS NOT NULL
        AND learning_progress.due_at <= CAST(:nowUtc AS INTEGER))
  )
ORDER BY learning_progress.due_at, f.id;

findProgressByCard:
SELECT * FROM learning_progress WHERE card_id = :cardId;

updateProgressGuarded:
UPDATE learning_progress SET
  box = :box,
  due_at = :dueAt,
  revision = revision + 1,
  repetition_count = :repetitionCount,
  lapse_count = :lapseCount,
  last_terminal_attempt_id = :lastTerminalAttemptId,
  -- Both arrive from the policy, never computed here. `srs_activated_at` is
  -- written on every terminal grade rather than only on activation because
  -- the policy returns the card's existing value unchanged after Box 1, so
  -- rewriting it is a no-op — and a legacy row whose value is NULL keeps
  -- NULL instead of acquiring a fabricated activation instant.
  srs_activated_at = :srsActivatedAt,
  last_reviewed_at = :lastReviewedAt,
  updated_at = :updatedAt
WHERE card_id = :cardId AND revision = :expectedRevision;

-- WBS 5.4.2 classification (surface-due-cards.md §4). Box carries the
-- queue, not the presence of a row:
--   New  = box 0 (initial state, dueAt null, not yet introduced)
--   Due  = box 1..7 with due_at <= nowUtc
--   box 8 = mastered, in no queue
-- The box range is stated even though the schema CHECK already forces
-- due_at to be null outside 1..7 — the queue contract should be
-- readable here rather than inferred from a constraint two files away.
-- Due-at-equal-now counts as due (§7).
pageDueProgress:
SELECT learning_progress.* FROM learning_progress
INNER JOIN flashcards ON flashcards.id = learning_progress.card_id
WHERE learning_progress.box BETWEEN 1 AND 7
  AND learning_progress.due_at IS NOT NULL
  AND learning_progress.due_at <= :nowUtc
  AND flashcards.deleted_at IS NULL
  AND flashcards.is_hidden = 0
ORDER BY learning_progress.due_at, learning_progress.id
LIMIT :limit OFFSET :offset;

-- Scoped queue counts (§5). A Leaf answers for its direct cards and a
-- Parent aggregates its descendant Leaves through the same recursive
-- walk, so an Empty deck answers zero rather than being special-cased.
-- COUNT(DISTINCT f.id) states the §1 "same card never twice" invariant
-- explicitly; the card_id UNIQUE index already makes the join 1:1, and
-- the DISTINCT is what keeps that true if the join ever widens.
-- The INNER JOIN drops a card whose progress row is missing: that is a
-- repair case owned by the 5.4.1 initialise contract, not a queue
-- member. Read-only — no queue query mutates progress (§9).
countDeckQueues:
WITH RECURSIVE subtree (id) AS (
  SELECT :deckId
  UNION ALL
  SELECT d.id FROM decks d INNER JOIN subtree s ON d.parent_id = s.id
)
SELECT
  COUNT(DISTINCT CASE
    WHEN lp.box BETWEEN 1 AND 7
      AND lp.due_at IS NOT NULL
      AND lp.due_at <= CAST(:nowUtc AS INTEGER)
      THEN f.id END) AS due_count,
  COUNT(DISTINCT CASE WHEN lp.box = 0 THEN f.id END) AS new_count
FROM flashcards f
INNER JOIN learning_progress lp ON lp.card_id = f.id
WHERE f.deck_id IN (SELECT id FROM subtree)
  AND f.deleted_at IS NULL
  AND f.is_hidden = 0;

-- Dashboard scope (§2): every eligible card in the pair's library.
countLibraryQueues:
SELECT
  COUNT(DISTINCT CASE
    WHEN lp.box BETWEEN 1 AND 7
      AND lp.due_at IS NOT NULL
      AND lp.due_at <= CAST(:nowUtc AS INTEGER)
      THEN f.id END) AS due_count,
  COUNT(DISTINCT CASE WHEN lp.box = 0 THEN f.id END) AS new_count
FROM flashcards f
INNER JOIN learning_progress lp ON lp.card_id = f.id
INNER JOIN decks d ON d.id = f.deck_id
WHERE d.language_pair_id = :languagePairId
  AND f.deleted_at IS NULL
  AND f.is_hidden = 0;

deleteProgressByCard:
DELETE FROM learning_progress WHERE card_id = :cardId;
